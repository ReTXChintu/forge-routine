{
  "name": "forgeroutine",
  "version": "0.1.1",
  "private": true,
  "description": "Forge your coding skills. Build your engineering mind.",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=!@forgeroutine/sandbox-worker",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "db:generate": "pnpm --filter @forgeroutine/database generate",
    "db:migrate": "pnpm --filter @forgeroutine/database migrate",
    "db:deploy": "pnpm --filter @forgeroutine/database migrate:deploy",
    "db:push": "pnpm --filter @forgeroutine/database push",
    "db:seed": "pnpm --filter @forgeroutine/database seed",
    "db:studio": "pnpm --filter @forgeroutine/database studio",
    "clean": "turbo run clean && rimraf node_modules",
    "prepare": "husky || true",
    "dev:worker": "turbo run dev --filter=@forgeroutine/sandbox-worker",
    "dev:apps": "turbo run dev --filter=@forgeroutine/web --filter=@forgeroutine/api",
    "db:reset": "pnpm --filter @forgeroutine/database exec dotenv -e ../../.env -- node ../../scripts/reset-db.mjs",
    "db:cancel-generation": "pnpm --filter @forgeroutine/database exec dotenv -e ../../.env -- node ../../scripts/cancel-pending-generation.mjs",
    "db:generation-plan": "pnpm --filter @forgeroutine/database exec dotenv -e ../../.env -- node ../../scripts/generation-plan.mjs",
    "release": "release-it",
    "release:minor": "release-it minor",
    "release:patch": "release-it patch",
    "release:major": "release-it major",
    "release:dry": "release-it --dry-run --ci",
    "start": "pm2 start ecosystem.config.cjs --env production",
    "stop": "pm2 stop all",
    "restart": "pm2 reload all",
    "delete": "pm2 delete all",
    "logs": "pm2 logs --lines 100",
    "status": "pm2 status",
    "start:inline": "pm2 start ecosystem.config.cjs --only forgeroutine-api,forgeroutine-web --env production",
    "db:sync-order": "pnpm --filter @forgeroutine/database exec dotenv -e ../../.env -- node ../../scripts/sync-technology-order.mjs",
    "db:ai-spend": "pnpm --filter @forgeroutine/database exec dotenv -e ../../.env -- node ../../scripts/ai-spend.mjs",
    "db:backfill-compulsory": "pnpm --filter @forgeroutine/database exec dotenv -e ../../.env -- node ../../scripts/backfill-compulsory.mjs",
    "db:purge-users": "pnpm --filter @forgeroutine/database exec dotenv -e ../../.env -- node ../../scripts/purge-users.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "pm2": "^7.0.4",
    "prettier": "^3.4.2",
    "release-it": "^21.0.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
