# =============================================================================
# ForgeRoutine environment contract
# Copy to `.env` at the repo root. Never commit `.env`.
# Every variable here is parsed and validated by @forgeroutine/config at boot.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# --- API ---------------------------------------------------------------------
API_PORT=50005
API_HOST=0.0.0.0
API_GLOBAL_PREFIX=api
CORS_ORIGINS=http://localhost:50004

# The zone every "today" is measured in. A learning day runs 06:00 to 06:00 in
# this zone, so a session that starts at 23:00 and ends at 01:00 counts as one
# day's work. Set it explicitly: the default is the host's own zone, which on a
# server is usually UTC and will file an evening's work under the day before.
APP_TIMEZONE=Asia/Kolkata

# Full path to the Claude Code CLI, for the "Claude Code (local)" AI provider.
# Only needed when the API process cannot find it on its own — a server started
# by a process manager or an IDE often has a different PATH from the shell the
# CLI was installed from. Find it with `where claude` (Windows) or
# `which claude` (macOS/Linux). On Windows point it at the .exe, not the .cmd.
# Leave unset to search PATH and the usual npm install locations.
# CLAUDE_CODE_BIN=

# Full path to the Codex CLI, for the "ChatGPT via Codex (local)" AI provider.
# Leave unset to find it automatically: on Windows the CLI bundled inside the
# Codex desktop app is located through its installed package, then PATH and
# ~/.local/bin are searched. Sign it in once with `codex login`.
# CODEX_BIN=

# --- PostgreSQL (external instance, source of truth) -------------------------
# Prisma reads DATABASE_URL directly.
DATABASE_URL=postgresql://forgeroutine:forgeroutine@localhost:5432/forgeroutine?schema=public
# Direct (non-pooled) URL used by `prisma migrate`. Keep it identical to DATABASE_URL
# unless DATABASE_URL points at a connection pooler, which cannot run migrations.
DIRECT_DATABASE_URL=postgresql://forgeroutine:forgeroutine@localhost:5432/forgeroutine?schema=public

# --- Redis (external instance: cache, queues, rate limiting) -----------------
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=forgeroutine:
# When false the API boots with a no-op cache and the inline execution driver.
REDIS_ENABLED=false

# --- Authentication ----------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# --- AI (per user; each account supplies its own provider and key in Settings)
# The server holds no vendor key and picks no vendor. What is left here is
# the envelope every call runs inside, whoever it goes to.
#
# Encrypts the keys users save. Without it Settings is read-only and there
# is no route to a model at all. openssl rand -base64 32
ENCRYPTION_KEY=
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
# Hard ceiling on tokens per user per day. 0 disables the guard.
AI_DAILY_TOKEN_BUDGET=200000

# --- Code execution sandbox --------------------------------------------------
# inline = API enqueues to an out-of-process runner directly (no Redis needed)
# queue  = API enqueues to Redis; apps/sandbox workers consume it
EXECUTION_DRIVER=inline
EXECUTION_TIMEOUT_MS=5000
EXECUTION_MAX_MEMORY_MB=128
EXECUTION_MAX_OUTPUT_BYTES=65536
EXECUTION_WORK_DIR=.sandbox-runs
EXECUTION_CONCURRENCY=2

# --- Web (Vite; only VITE_* reaches the browser bundle) ----------------------
VITE_API_BASE_URL=http://localhost:50005/api/v1
VITE_APP_NAME=ForgeRoutine
