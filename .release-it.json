{
  "$schema": "https://unpkg.com/release-it/schema/release-it.json",
  "hooks": {
    "before:init": ["pnpm lint", "pnpm typecheck", "pnpm test"],
    "after:bump": "node scripts/bump-versions.mjs ${version} --stage",
    "after:release": "echo Released v${version}. CD builds the APK on the tag."
  },
  "git": {
    "requireCleanWorkingDir": true,
    "requireBranch": "main",
    "commitMessage": "chore(release): v${version}",
    "tagName": "v${version}",
    "tagAnnotation": "v${version}",
    "push": true
  },
  "npm": {
    "publish": false
  },
  "github": {
    "release": true,
    "releaseName": "v${version}",
    "autoGenerate": true
  }
}
